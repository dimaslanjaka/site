#!/bin/bash
set -u

cwd="$(pwd)"
max_jobs=4

# colors
GREEN='\033[0;32m'
RED='\033[0;31m'
GRAY='\033[0;90m'
BLUE='\033[0;34m'
NC='\033[0m'

timestamp() {
  date "+%Y-%m-%d %H:%M:%S"
}

relative_path() {
  local path="$1"

  path="${path#"$cwd"/}"

  [[ "$path" == "$cwd" ]] && path="."

  echo "$path"
}

log() {
  local level="$1"
  shift

  local color="$NC"

  case "$level" in
    OK) color="$GREEN" ;;
    FAIL) color="$RED" ;;
    SKIP) color="$GRAY" ;;
    INFO) color="$BLUE" ;;
  esac

  echo -e "[${GRAY}$(timestamp)${NC}] [${color}${level}${NC}] $*"
}

# collect all node_modules targets
declare -a NODE_MODULES_TARGETS

# root node_modules
NODE_MODULES_TARGETS+=("${cwd}/node_modules")

# yarn workspaces node_modules
if command -v yarn >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  while IFS='|' read -r workspace_name workspace_location; do
    workspace_path="${cwd}/${workspace_location}"
    workspace_node_modules="${workspace_path}/node_modules"

    [[ -d "$workspace_path" ]] || continue

    NODE_MODULES_TARGETS+=("$workspace_node_modules")
  done < <(
    yarn workspaces list --json 2>/dev/null |
    jq -r '"\(.name)|\(.location)"'
  )
else
  log SKIP "yarn or jq not found"
fi

# remove duplicate paths
declare -A seen_targets
declare -a unique_targets

for target in "${NODE_MODULES_TARGETS[@]}"; do
  [[ -n "${seen_targets[$target]:-}" ]] && continue

  seen_targets["$target"]=1
  unique_targets+=("$target")
done

NODE_MODULES_TARGETS=("${unique_targets[@]}")

cleanup_letter() {
  local base="$1"
  local letter="$2"

  [[ -d "$base" ]] || return 0

  shopt -s nullglob

  local targets=(
    "${base}/${letter}"*
    "${base}/@types/${letter}"*
    "${base}/@${letter}"*
  )

  local removed_any=0

  for path in "${targets[@]}"; do
    [[ -e "$path" ]] || continue

    local rel
    rel="$(relative_path "$path")"

    if rm -rf "$path"; then
      log OK "$rel"
      removed_any=1
    else
      log FAIL "$rel"
    fi
  done

  if (( removed_any == 0 )); then
    log SKIP "$(relative_path "$base") '${letter}'"
  fi
}

export -f cleanup_letter
export -f log
export -f timestamp
export -f relative_path

export cwd
export GREEN RED GRAY BLUE NC

log INFO "Detected ${#NODE_MODULES_TARGETS[@]} node_modules directories"

for target in "${NODE_MODULES_TARGETS[@]}"; do
  log INFO "$(relative_path "$target")"
done

running=0

for base in "${NODE_MODULES_TARGETS[@]}"; do
  for letter in $(printf "%s\n" {a..z} | shuf); do
    cleanup_letter "$base" "$letter" &

    ((running++))

    if (( running >= max_jobs )); then
      wait -n
      ((running--))
    fi
  done
done

wait

log INFO "Removing remaining node_modules directories"

for target in "${NODE_MODULES_TARGETS[@]}"; do
  [[ -e "$target" ]] || continue

  rel="$(relative_path "$target")"

  if rm -rf "$target"; then
    log OK "$rel"
  else
    log FAIL "$rel"
  fi
done

log INFO "Done"