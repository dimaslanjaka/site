#!/bin/bash
set -u

cwd="$(pwd)"
max_jobs=4
log_file="${cwd}/cleanup.log"
fail_file="${cwd}/cleanup.failed.log"

# reset logs
: > "$log_file"
: > "$fail_file"

timestamp() {
  date "+%Y-%m-%d %H:%M:%S"
}

relative_path() {
  local path="$1"

  # remove cwd prefix
  path="${path#"$cwd"/}"

  # fallback for exact cwd match
  [[ "$path" == "$cwd" ]] && path="."

  echo "$path"
}

log() {
  echo "[$(timestamp)] $*" | tee -a "$log_file"
}

cleanup_letter() {
  local letter="$1"

  shopt -s nullglob

  local targets=(
    "${cwd}/node_modules/${letter}"*
    "${cwd}/node_modules/@types/${letter}"*
    "${cwd}/node_modules/@${letter}"*
  )

  local removed_any=0

  for path in "${targets[@]}"; do
    local rel
    rel="$(relative_path "$path")"

    if rm -rf "$path"; then
      log "[OK] Removed: $rel"
      removed_any=1
    else
      log "[ERROR] Failed to remove: $rel"
      echo "$rel" >> "$fail_file"
    fi
  done

  if (( removed_any == 0 )); then
    log "[SKIP] No matching packages for '${letter}'"
  fi
}

export -f cleanup_letter
export -f log
export -f timestamp
export -f relative_path

export cwd log_file fail_file

log "[START] Cleaning: $(relative_path "${cwd}/node_modules")"

running=0

for letter in $(printf "%s\n" {a..z} | shuf); do
  cleanup_letter "$letter" &

  ((running++))

  if (( running >= max_jobs )); then
    wait -n
    ((running--))
  fi
done

wait

log "[PHASE] Letter cleanup completed"
log "[PHASE] Removing remaining node_modules directory"

# final cleanup
final_target="${cwd}/node_modules"
final_rel="$(relative_path "$final_target")"

if rm -rf "$final_target"; then
  log "[OK] Removed directory: $final_rel"
else
  log "[ERROR] Failed to remove directory: $final_rel"
  echo "$final_rel" >> "$fail_file"
fi

log "[DONE] Cleanup finished"

# summary report
echo ""
echo "================ CLEANUP SUMMARY ================"
echo "Log file : $(relative_path "$log_file")"

if [[ -s "$fail_file" ]]; then
  echo ""
  echo "Failed paths:"
  cat "$fail_file"
else
  echo ""
  echo "No failures detected."
fi

echo "================================================="